{
  "name": "otosazu-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Otosazu の進捗の公開（要約 1 件を預かって配るだけ）。仕様書 5.22。",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wrangler": "^3.99.0"
  }
}
