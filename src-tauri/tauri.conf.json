{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otosazu",
  "version": "0.1.0",
  "identifier": "app.otosazu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Otosazu",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tozicode",
    "copyright": "© 2026 tozicode",
    "category": "Productivity",
    "shortDescription": "漫画制作スケジュール管理ソフト",
    "longDescription": "CLIP STUDIO PAINT の漫画ファイルと連動して、ページ×工程ごとの作業時間を記録し、完成日を予測します。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
